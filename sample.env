# .NET Boilerplate Environment Configuration
# Copy this file to .env and update the values

# Application
ASPNETCORE_ENVIRONMENT=Production
PORT=8080
ASPNETCORE_URLS=http://+:8080

# Database - PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMeInProduction!
POSTGRES_DB=dotnetboilerplate
POSTGRES_PORT=5432

# Connection String (used by the API)
# Format: Host=postgres;Port=5432;Database=dbname;Username=user;Password=pass
ConnectionStrings__Default=Host=postgres;Port=5432;Database=dotnetboilerplate;Username=postgres;Password=ChangeMeInProduction!

# JWT Configuration
JWT_SECRET=ThisIsASecretKeyForJWTTokenGenerationPleaseChangeInProduction123!MustBe256BitsOrLonger
JWT_ISSUER=DotNetBoilerplate
JWT_AUDIENCE=DotNetBoilerplateUsers
JWT_EXPIRY_MINUTES=15

# CORS (comma-separated origins)
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
Cors__AllowedOrigins__2=https://yourdomain.com

# Serilog (optional overrides)
Serilog__MinimumLevel__Default=Information

# Coolify Deployment Notes:
# 1. Set these environment variables in Coolify's environment settings
# 2. Make sure ConnectionStrings__Default points to your Coolify PostgreSQL service
# 3. Update JWT_SECRET with a strong random value
# 4. Update POSTGRES_PASSWORD with a strong password
# 5. Set Cors__AllowedOrigins to your frontend domain(s)
